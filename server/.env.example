# ---- server ----
PORT=8787
DB_PATH=./data/outdeals.db
# Where the board is served from; payers are sent back here after checkout.
SITE_URL=https://iansells2025.github.io/github-pages/deals/index.html
# This API's own public origin (used to build the Stripe return + dev checkout URLs).
API_BASE_URL=https://api.example.com
# Comma-separated browser origins allowed to call the API. "*" for open access.
ALLOWED_ORIGINS=https://iansells2025.github.io
# Set when running behind a proxy/load balancer so req.ip is the real client.
TRUST_PROXY=0

# ---- payments ----
# Live bids require BOTH of these. Without them the server refuses to take bids
# unless ALLOW_DEV_PAYMENTS=1 (local testing only — it hands out free spots).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_DEV_PAYMENTS=0

# ---- link checking ----
# Run a background link check every N minutes (0 = off; use `npm run check-links`
# or POST /api/admin/check instead). Only an unambiguous 404/410 flags a listing,
# and flagged listings are queued for review, never removed automatically.
CHECK_LINKS_INTERVAL_MIN=0
CHECK_LIMIT=50
CHECK_DELAY_MS=1000

# ---- misc ----
# Fill a brand-new database with the demo listings in shared/seed.js.
SEED_ON_EMPTY=1
# Required by POST /api/admin/remove for taking down dead or fake listings.
ADMIN_TOKEN=
